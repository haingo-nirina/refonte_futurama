# Base PostgreSQL (Aiven). `sslmode` est retire de l'URL par PrismaService et
# traduit en objet `ssl` : voir src/prisma/prisma.service.ts.
DATABASE_URL='postgres://user:password@host:port/defaultdb?sslmode=require'

# Optionnel : chemin vers le CA Aiven. Renseigne, la chaine de certificats est
# reellement verifiee (recommande en production, passer alors l'URL en
# `sslmode=verify-full`).
# DATABASE_CA_CERT=./certs/aiven-ca.pem

# Le frontend Next occupe 3000 : le backend est deplace pour eviter la collision.
PORT=3001

# Secret de signature des JWT. A generer par environnement, jamais commite :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Optionnel : duree de validite des tokens (defaut 7d).
# JWT_EXPIRES_IN=7d
