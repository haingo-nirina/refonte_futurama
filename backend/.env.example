# Base PostgreSQL (Aiven). `sslmode` est retire de l'URL par PrismaService et
# traduit en objet `ssl` : voir src/prisma/prisma.service.ts.
DATABASE_URL='postgres://user:password@host:port/defaultdb?sslmode=require'

# Optionnel : chemin vers le CA Aiven. Renseigne, la chaine de certificats est
# reellement verifiee (recommande en production, passer alors l'URL en
# `sslmode=verify-full`).
# DATABASE_CA_CERT=./certs/aiven-ca.pem

# Le frontend Next occupe 3000 : le backend est deplace pour eviter la collision.
PORT=3001

# Secret de signature des JWT. A generer par environnement, jamais commite :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Optionnel : duree de validite des tokens (defaut 7d).
# JWT_EXPIRES_IN=7d

# Optionnel : detection automatique des lives de la Page Facebook (cron 30 s).
# Sans FB_PAGE_ID ou FB_PAGE_TOKEN, la detection est desactivee : la vendeuse
# lance et termine le live a la main depuis le backoffice (lien colle).
# FB_PAGE_TOKEN est un token de *Page* (pas de compte utilisateur), longue duree,
# avec la permission pages_read_engagement. Il ne sort jamais du backend.
# FB_PAGE_ID=
# FB_PAGE_TOKEN=
# FB_GRAPH_VERSION=v26.0

# Paiement MVola. `mvola_mock` (defaut) simule MVola sans rien appeler : la
# confirmation arrive seule apres quelques secondes — refuse au demarrage si
# NODE_ENV=production (pose par `yarn start:prod`). `mvola` appelle la vraie
# API avec les identifiants ci-dessous. `manuel` n'envoie aucune demande : le
# client voit le numero MVOLA_MERCHANT_MSISDN ou envoyer l'argent, et l'admin
# passe la commande « Payée » a la main. Voir src/payments/.
# PAYMENT_PROVIDER=mvola_mock
# sandbox (devapi.mvola.mg, defaut) ou production (api.mvola.mg)
# MVOLA_ENV=sandbox
# Adresse publique HTTPS de PUT /payments/mvola/callback. Facultative : sans
# elle, le serveur relit le statut chez MVola toutes les 5 s.
# MVOLA_CALLBACK_URL=https://exemple.mg/api/payments/mvola/callback

# Identifiants du portail developpeur MVola (developer.mvola.mg). Les vraies
# valeurs vont dans `.env`, jamais ici : ce fichier est commite.
MVOLA_CONSUMER_KEY=
MVOLA_CONSUMER_SECRET=
MVOLA_PARTNER_NAME=
# Numero marchand qui encaisse (sandbox : 0343500004)
MVOLA_MERCHANT_MSISDN=
