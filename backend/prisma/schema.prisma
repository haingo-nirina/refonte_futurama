generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =========================================================
// Comptes
// =========================================================

// role: customer | admin -- 'admin' sert pour les endpoints proteges
// (moderation des avis, changement de statut de commande) qui n'ont
// pour l'instant aucune protection -- a traiter en meme temps que ce module
model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String        @map("password_hash")
  fullName     String        @map("full_name")
  phone        String?
  address      String?
  role         String        @default("customer")
  carts        Cart[]
  orders       Order[]
  reviews      Review[]
  postComments PostComment[]
  postLikes    PostLike[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("users")
}

// =========================================================
// Catalogue
// =========================================================

model Category {
  id           String     @id @default(uuid())
  name         String
  slug         String     @unique
  parentId     String?    @map("parent_id")
  parent       Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[] @relation("CategoryTree")
  imageUrl     String?    @map("image_url")
  displayOrder Int        @default(0) @map("display_order")
  isFeatured   Boolean    @default(false) @map("is_featured")
  products     Product[]
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@map("categories")
}

/// Marque d'un produit (Moulinex, Tefal...). Le *vendeur*, lui, n'est pas une
/// donnee : la boutique vend en direct, il est ecrit en dur cote front.
model Marque {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  logoUrl   String?   @map("logo_url")
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("marques")
}

model Product {
  id            String            @id @default(uuid())
  categoryId    String            @map("category_id")
  category      Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  marqueId      String?           @map("marque_id")
  marque        Marque?           @relation(fields: [marqueId], references: [id], onDelete: SetNull)
  name          String
  slug          String            @unique
  reference     String?
  description   String?
  price         Decimal           @db.Decimal(12, 2)
  promoPrice    Decimal?          @map("promo_price") @db.Decimal(12, 2)
  stock         Int               @default(0)
  isPremium     Boolean           @default(false) @map("is_premium")
  videoUrl      String?           @map("video_url")
  viewsCount    Int               @default(0) @map("views_count")
  isActive      Boolean           @default(true) @map("is_active")
  images        ProductImage[]
  specs         ProductSpec[]
  relationsFrom ProductRelation[] @relation("RelationFrom")
  relationsTo   ProductRelation[] @relation("RelationTo")
  promotions    Promotion[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  reviews       Review[]
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@map("products")
}

model ProductImage {
  id           String  @id @default(uuid())
  productId    String  @map("product_id")
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl     String  @map("image_url")
  displayOrder Int     @default(0) @map("display_order")
  isPrimary    Boolean @default(false) @map("is_primary")

  @@map("product_images")
}

model ProductSpec {
  id           String  @id @default(uuid())
  productId    String  @map("product_id")
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label        String
  value        String
  displayOrder Int     @default(0) @map("display_order")

  @@map("product_specs")
}

// relationType: "similar" | "frequently_bought_together"
model ProductRelation {
  id               String  @id @default(uuid())
  productId        String  @map("product_id")
  product          Product @relation("RelationFrom", fields: [productId], references: [id], onDelete: Cascade)
  relatedProductId String  @map("related_product_id")
  relatedProduct   Product @relation("RelationTo", fields: [relatedProductId], references: [id], onDelete: Cascade)
  relationType     String  @map("relation_type")

  @@unique([productId, relatedProductId, relationType])
  @@map("product_relations")
}

model Promotion {
  id              String   @id @default(uuid())
  productId       String   @map("product_id")
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  discountPercent Decimal  @map("discount_percent") @db.Decimal(5, 2)
  startDate       DateTime @map("start_date")
  endDate         DateTime @map("end_date")
  isActive        Boolean  @default(true) @map("is_active")

  @@map("promotions")
}

// =========================================================
// Vente
// =========================================================

// userId optionnel : le panier peut demarrer en invite (sessionId),
// se rattacher a un compte une fois connecte
model Cart {
  id         String     @id @default(uuid())
  userId     String?    @map("user_id")
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId  String?    @map("session_id")
  items      CartItem[]
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String   @map("cart_id")
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([cartId, productId])
  @@map("cart_items")
}

// userId obligatoire : passer commande exige d'etre connecte.
// shippingName/Phone/Address restent dupliques (pas juste une reference
// a users) : l'adresse de livraison d'UNE commande peut differer du
// profil (livrer chez un proche, au bureau...) et ne doit jamais bouger
// retroactivement si le profil change ensuite.
// status: pending | confirmed | shipped | delivered | cancelled
// paymentMethod: cash_on_delivery | mvola | orange_money
model Order {
  id              String      @id @default(uuid())
  userId          String      @map("user_id")
  user            User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  shippingName    String      @map("shipping_name")
  shippingPhone   String      @map("shipping_phone")
  shippingAddress String      @map("shipping_address")
  status          String      @default("pending")
  paymentMethod   String      @map("payment_method")
  subtotal        Decimal     @db.Decimal(12, 2)
  shippingFee     Decimal     @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  total           Decimal     @db.Decimal(12, 2)
  items           OrderItem[]
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?  @map("product_id")
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String   @map("product_name")
  quantity    Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)

  @@map("order_items")
}

// =========================================================
// Avis & Contenu
// =========================================================

// userId obligatoire, remplace l'ancien authorName en texte libre :
// le nom affiche vient du compte, plus de faux avis anonymes.
// moderationStatus: pending | approved | rejected
model Review {
  id               String   @id @default(uuid())
  productId        String   @map("product_id")
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String   @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating           Int
  comment          String?
  moderationStatus String   @default("pending") @map("moderation_status")
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([productId, userId])
  @@map("reviews")
}

model Reseller {
  id           String  @id @default(uuid())
  name         String
  address      String
  phone        String?
  hours        String?
  logoUrl      String? @map("logo_url")
  displayOrder Int     @default(0) @map("display_order")

  @@map("resellers")
}

model Post {
  id          String        @id @default(uuid())
  title       String
  slug        String        @unique
  content     String
  photoUrl    String?       @map("photo_url")
  viewsCount  Int           @default(0) @map("views_count")
  likesCount  Int           @default(0) @map("likes_count")
  publishedAt DateTime?     @map("published_at")
  likes       PostLike[]
  comments    PostComment[]
  createdAt   DateTime      @default(now()) @map("created_at")

  @@map("posts")
}

// userId remplace l'ancien sessionId : un like = un compte
model PostLike {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([postId, userId])
  @@map("post_likes")
}

// userId remplace l'ancien authorName en texte libre
model PostComment {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("post_comments")
}
