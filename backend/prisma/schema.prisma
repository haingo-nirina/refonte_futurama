generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =========================================================
// Comptes
// =========================================================

// role: customer | admin -- 'admin' sert pour les endpoints proteges
// (moderation des avis, changement de statut de commande) qui n'ont
// pour l'instant aucune protection -- a traiter en meme temps que ce module
model User {
  id                 String               @id @default(uuid())
  email              String               @unique
  passwordHash       String               @map("password_hash")
  fullName           String               @map("full_name")
  phone              String?
  address            String?
  role               String               @default("customer")
  carts              Cart[]
  orders             Order[]
  reviews            Review[]
  postComments       PostComment[]
  postLikes          PostLike[]
  liveMessages       LiveMessage[]
  orderStatusChanges OrderStatusHistory[]
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  @@map("users")
}

// =========================================================
// Catalogue
// =========================================================

model Category {
  id           String     @id @default(uuid())
  name         String
  slug         String     @unique
  parentId     String?    @map("parent_id")
  parent       Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[] @relation("CategoryTree")
  imageUrl     String?    @map("image_url")
  displayOrder Int        @default(0) @map("display_order")
  isFeatured   Boolean    @default(false) @map("is_featured")
  products     Product[]
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@map("categories")
}

/// Marque d'un produit (Moulinex, Tefal...). Le *vendeur*, lui, n'est pas une
/// donnee : la boutique vend en direct, il est ecrit en dur cote front.
model Marque {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  logoUrl   String?   @map("logo_url")
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("marques")
}

model Product {
  id            String            @id @default(uuid())
  categoryId    String            @map("category_id")
  category      Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  marqueId      String?           @map("marque_id")
  marque        Marque?           @relation(fields: [marqueId], references: [id], onDelete: SetNull)
  name          String
  slug          String            @unique
  reference     String?
  /// Couleurs disponibles, texte libre : [« Noir mat », « Inox brosse »].
  colors        String[]          @default([])
  /// Texte libre, unite comprise : « 30 x 20 x 15 cm ».
  dimensions    String?
  description   String?
  price         Decimal           @db.Decimal(12, 2)
  promoPrice    Decimal?          @map("promo_price") @db.Decimal(12, 2)
  stock         Int               @default(0)
  isPremium     Boolean           @default(false) @map("is_premium")
  videoUrl      String?           @map("video_url")
  viewsCount    Int               @default(0) @map("views_count")
  isActive      Boolean           @default(true) @map("is_active")
  images        ProductImage[]
  specs         ProductSpec[]
  relationsFrom ProductRelation[] @relation("RelationFrom")
  relationsTo   ProductRelation[] @relation("RelationTo")
  promotions    Promotion[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  reviews       Review[]
  liveProducts  LiveProduct[]
  liveMessages  LiveMessage[]
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@map("products")
}

model ProductImage {
  id           String  @id @default(uuid())
  productId    String  @map("product_id")
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl     String  @map("image_url")
  displayOrder Int     @default(0) @map("display_order")
  isPrimary    Boolean @default(false) @map("is_primary")

  @@map("product_images")
}

model ProductSpec {
  id           String  @id @default(uuid())
  productId    String  @map("product_id")
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label        String
  value        String
  displayOrder Int     @default(0) @map("display_order")

  @@map("product_specs")
}

// relationType: "similar" | "frequently_bought_together"
model ProductRelation {
  id               String  @id @default(uuid())
  productId        String  @map("product_id")
  product          Product @relation("RelationFrom", fields: [productId], references: [id], onDelete: Cascade)
  relatedProductId String  @map("related_product_id")
  relatedProduct   Product @relation("RelationTo", fields: [relatedProductId], references: [id], onDelete: Cascade)
  relationType     String  @map("relation_type")

  @@unique([productId, relatedProductId, relationType])
  @@map("product_relations")
}

/// Promotion appliquee a un produit sur une plage de dates.
///
/// Le prix reduit n'est JAMAIS stocke : il se calcule a la volee depuis
/// `Product.price` et `discountPercent` (PromotionsService.getActivePromotionForProduct).
///
/// `isFeatured` fait entrer la promotion dans la section « Promotion du mois »
/// de l'accueil. Ce n'est pas un elu unique : la maquette aligne quatre
/// produits, chacun avec sa propre remise.
model Promotion {
  id              String   @id @default(uuid())
  productId       String   @map("product_id")
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  titre           String?
  discountPercent Decimal  @map("discount_percent") @db.Decimal(5, 2)
  startDate       DateTime @map("start_date")
  endDate         DateTime @map("end_date")
  isActive        Boolean  @default(true) @map("is_active")
  isFeatured      Boolean  @default(false) @map("is_featured")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([productId, isActive, startDate, endDate])
  @@index([isFeatured, isActive, startDate, endDate])
  @@map("promotions")
}

// =========================================================
// Vente
// =========================================================

// userId optionnel : le panier peut demarrer en invite (sessionId),
// se rattacher a un compte une fois connecte
model Cart {
  id        String     @id @default(uuid())
  userId    String?    @map("user_id")
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId String?    @map("session_id")
  items     CartItem[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String   @map("cart_id")
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([cartId, productId])
  @@map("cart_items")
}

// userId obligatoire : passer commande exige d'etre connecte.
// contactName/Phone et shippingAddress restent dupliques (pas juste une
// reference a users) : le contact et l'adresse d'UNE commande peuvent differer
// du profil (livrer chez un proche, au bureau...) et ne doivent jamais bouger
// retroactivement si le profil change ensuite. Meme logique pour le nom et le
// delai de la zone, copies au moment de la commande.
//
// shippingAddress / deliveryZone* : renseignes en LIVRAISON, null en retrait.
// storeId : renseigne en RETRAIT_BOUTIQUE, null en livraison.
// Les transitions de statut autorisees sont dans src/orders/order-status.ts.
model Order {
  id                 String               @id @default(uuid())
  /// Numero lisible FUT-AAAA-000123, attribue via OrderCounter
  number             String               @unique
  userId             String               @map("user_id")
  user               User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  fulfillmentMethod  FulfillmentMethod    @map("fulfillment_method")
  contactName        String               @map("contact_name")
  contactPhone       String               @map("contact_phone")
  shippingAddress    String?              @map("shipping_address")
  deliveryZoneId     String?              @map("delivery_zone_id")
  deliveryZone       DeliveryZone?        @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  deliveryZoneName   String?              @map("delivery_zone_name")
  deliveryDelayDays  Int?                 @map("delivery_delay_days")
  /// Calculee au paiement, en jours ouvres depuis paidAt
  expectedDeliveryAt DateTime?            @map("expected_delivery_at") @db.Date
  storeId            String?              @map("store_id")
  store              Store?               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  /// Live depuis lequel la commande a ete passee, pour mesurer ses ventes.
  /// Restrict : supprimer un live qui a vendu effacerait sa mesure.
  liveId             String?              @map("live_id")
  live               Live?                @relation(fields: [liveId], references: [id], onDelete: Restrict)
  status             OrderStatus          @default(EN_ATTENTE_PAIEMENT)
  paymentStatus      PaymentStatus        @default(NON_PAYE) @map("payment_status")
  paymentMethod      PaymentMethod        @map("payment_method")
  mvolaPhone         String?              @map("mvola_phone")
  subtotal           Decimal              @db.Decimal(12, 2)
  shippingFee        Decimal              @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  total              Decimal              @db.Decimal(12, 2)
  paidAt             DateTime?            @map("paid_at")
  /// Code a 4 chiffres genere au passage a PRETE_A_RETIRER
  pickupCode         String?              @map("pickup_code") @db.Char(4)
  pickupCodeAttempts Int                  @default(0) @map("pickup_code_attempts")
  items              OrderItem[]
  payments           Payment[]
  statusHistory      OrderStatusHistory[]
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([paidAt])
  @@index([liveId])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?  @map("product_id")
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String   @map("product_name")
  quantity    Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)

  @@map("order_items")
}

enum OrderStatus {
  EN_ATTENTE_PAIEMENT
  PAYEE
  EN_PREPARATION
  EXPEDIEE
  LIVREE
  PRETE_A_RETIRER
  RETIREE
  ANNULEE
}

enum PaymentStatus {
  NON_PAYE
  PAYE
  ECHOUE
}

enum FulfillmentMethod {
  LIVRAISON
  RETRAIT_BOUTIQUE
}

// CASH_ON_DELIVERY n'est conserve que pour les commandes anterieures au
// paiement MVola : le DTO de creation le refuse.
enum PaymentMethod {
  MVOLA
  CASH_ON_DELIVERY
}

enum PaymentTransactionStatus {
  EN_ATTENTE
  REUSSI
  ECHOUE
}

/// Zone de livraison : le prix facture est recalcule cote serveur depuis
/// cette table, jamais lu dans la requete du client.
model DeliveryZone {
  id            String   @id @default(uuid())
  name          String   @unique
  price         Decimal  @db.Decimal(12, 2)
  /// Delai en jours ouvres (lundi-vendredi, hors feries)
  delayDays     Int      @map("delay_days")
  /// Livraison gratuite des que le sous-total atteint ce montant
  freeThreshold Decimal? @map("free_threshold") @db.Decimal(12, 2)
  isActive      Boolean  @default(true) @map("is_active")
  displayOrder  Int      @default(0) @map("display_order")
  orders        Order[]
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("delivery_zones")
}

/// Point de retrait. Le panier propose toutes les boutiques actives ; elles se
/// gerent depuis le backoffice (/admin/livraison).
model Store {
  id              String   @id @default(uuid())
  name            String
  address         String
  phone           String
  /// Texte multi-lignes, affiche tel quel
  openingHours    String   @map("opening_hours")
  /// Centre seulement la carte : Google retrouve la boutique par nom + adresse
  latitude        Decimal? @db.Decimal(9, 6)
  longitude       Decimal? @db.Decimal(9, 6)
  /// Jours ouvres avant qu'une commande soit prete au retrait : 0 = « En stock »
  pickupDelayDays Int      @default(0) @map("pickup_delay_days")
  isActive        Boolean  @default(true) @map("is_active")
  orders          Order[]
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("stores")
}

/// Une tentative de paiement. Plusieurs par commande possibles ; providerRef
/// unique rend le callback idempotent.
// provider: mvola_mock | mvola
model Payment {
  id            String                   @id @default(uuid())
  orderId       String                   @map("order_id")
  order         Order                    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider      String
  providerRef   String                   @unique @map("provider_ref")
  amount        Decimal                  @db.Decimal(12, 2)
  phone         String
  status        PaymentTransactionStatus @default(EN_ATTENTE)
  rawCallback   Json?                    @map("raw_callback")
  failureReason String?                  @map("failure_reason")
  requestedAt   DateTime                 @default(now()) @map("requested_at")
  completedAt   DateTime?                @map("completed_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")

  @@index([orderId])
  @@map("payments")
}

/// changedById null = systeme (callback de paiement, annulation planifiee)
model OrderStatusHistory {
  id          String       @id @default(uuid())
  orderId     String       @map("order_id")
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  changedById String?      @map("changed_by_id")
  changedBy   User?        @relation(fields: [changedById], references: [id], onDelete: SetNull)
  note        String?
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

/// Compteur annuel du numero de commande, incremente dans la transaction de
/// creation : deux commandes simultanees n'obtiennent jamais le meme numero.
model OrderCounter {
  year      Int @id
  lastValue Int @default(0) @map("last_value")

  @@map("order_counters")
}

// =========================================================
// Avis & Contenu
// =========================================================

// userId obligatoire, remplace l'ancien authorName en texte libre :
// le nom affiche vient du compte, plus de faux avis anonymes.
// moderationStatus: pending | approved | rejected
model Review {
  id               String   @id @default(uuid())
  productId        String   @map("product_id")
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String   @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating           Int
  comment          String?
  moderationStatus String   @default("pending") @map("moderation_status")
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([productId, userId])
  @@map("reviews")
}

model Reseller {
  id           String  @id @default(uuid())
  name         String
  address      String
  phone        String?
  hours        String?
  logoUrl      String? @map("logo_url")
  displayOrder Int     @default(0) @map("display_order")

  @@map("resellers")
}

model Post {
  id          String        @id @default(uuid())
  title       String
  slug        String        @unique
  content     String
  photoUrl    String?       @map("photo_url")
  viewsCount  Int           @default(0) @map("views_count")
  likesCount  Int           @default(0) @map("likes_count")
  publishedAt DateTime?     @map("published_at")
  likes       PostLike[]
  comments    PostComment[]
  createdAt   DateTime      @default(now()) @map("created_at")

  @@map("posts")
}

// userId remplace l'ancien sessionId : un like = un compte
model PostLike {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([postId, userId])
  @@map("post_likes")
}

// userId remplace l'ancien authorName en texte libre
// parentId : reponse de la boutique a un commentaire. Un seul niveau — une
// reponse n'a jamais d'enfant —, et seule une route admin en cree : le mur les
// signe donc « Futurama.mg », comme la publication elle-meme.
model PostComment {
  id        String        @id @default(uuid())
  postId    String        @map("post_id")
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String        @map("user_id")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   String
  parentId  String?       @map("parent_id")
  parent    PostComment?  @relation("PostCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   PostComment[] @relation("PostCommentReplies")
  createdAt DateTime      @default(now()) @map("created_at")

  @@map("post_comments")
}

// =========================================================
// Live shopping
// =========================================================

/// Un live Facebook diffuse sur la page de la boutique. La video ne passe
/// jamais par nos serveurs : `facebookUrl` est l'adresse publique du live,
/// que le front integre dans le lecteur Facebook (<iframe>). La meme URL sert
/// de replay une fois le live termine.
///
/// Le statut est pilote a la main depuis le backoffice : Facebook ne previent
/// pas notre API du debut ni de la fin de la diffusion.
///
/// `facebookUrl` reste vide tant que le live est PROGRAMME : la video Facebook
/// n'existe qu'une fois la diffusion lancee. « Demarrer » l'exige.
model Live {
  id          String        @id @default(uuid())
  title       String
  description String?
  facebookUrl String?       @map("facebook_url")
  status      LiveStatus    @default(PROGRAMME)
  /// Date annoncee au public ; startedAt / endedAt sont les dates reelles,
  /// posees par les boutons « Demarrer » / « Terminer ».
  scheduledAt DateTime      @map("scheduled_at")
  startedAt   DateTime?     @map("started_at")
  endedAt     DateTime?     @map("ended_at")
  products    LiveProduct[]
  messages    LiveMessage[]
  orders      Order[]
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@map("lives")
}

enum LiveStatus {
  PROGRAMME
  EN_DIRECT
  TERMINE
}

/// Produits presentes pendant le live, affiches a cote de la video.
/// Remplaces en bloc comme les images d'un produit (PUT /lives/:id/products).
model LiveProduct {
  id           String  @id @default(uuid())
  liveId       String  @map("live_id")
  live         Live    @relation(fields: [liveId], references: [id], onDelete: Cascade)
  productId    String  @map("product_id")
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  displayOrder Int     @default(0) @map("display_order")

  @@unique([liveId, productId])
  @@map("live_products")
}

/// Question privee d'un client pendant le live : visible de son auteur et de
/// la boutique seulement (pas de chat public). Rattachee a un compte.
///
/// Une seule reponse, de la boutique, portee par la ligne elle-meme : pas de
/// fil, donc pas d'auto-relation comme sur le mur.
/// `handledAt` vide = message en attente, c'est ce que compte le badge du
/// backoffice. Repondre le renseigne aussi : une question repondue est traitee.
model LiveMessage {
  id        String    @id @default(uuid())
  liveId    String    @map("live_id")
  live      Live      @relation(fields: [liveId], references: [id], onDelete: Cascade)
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Produit concerne par la question, facultatif
  productId String?   @map("product_id")
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  message   String
  reply     String?
  repliedAt DateTime? @map("replied_at")
  handledAt DateTime? @map("handled_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([liveId, createdAt])
  @@index([userId, liveId])
  @@map("live_messages")
}
